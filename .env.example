PORT=4317
DATABASE_PATH=./data/prospect-lieux-b2b.sqlite

# Sources gratuites, sans cle API et sans carte bancaire.
# L'application bascule automatiquement entre:
# - https://overpass.private.coffee/api/interpreter
# - https://overpass-api.de/api/interpreter
# - https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Test limite demande: 20 lieux maximum par actualisation.
SYNC_LIMIT=20

# Active une actualisation hebdomadaire locale au demarrage du serveur.
# Valeurs: true / false
AUTO_SYNC_WEEKLY=false

# Supabase, a renseigner uniquement quand le projet Supabase Free est actif.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
